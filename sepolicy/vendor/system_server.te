# Allow system_server to read Fast Charging status
allow system_server vendor_sysfs_battery_supply:file rw_file_perms;

allow system_server vendor_sysfs_graphics:file rw_file_perms;

# GPU kernel manager
allow system_server vendor_sysfs_kgsl:dir r_dir_perms;
allow system_server vendor_sysfs_kgsl:file rw_file_perms;
allow system_server vendor_sysfs_kgsl:lnk_file r_file_perms;
allow system_server vendor_sysfs_kgsl_gpuclk:file r_file_perms;

# CPU frequency control (AxKernelManagerService writes scaling_{min,max}_freq)
allow system_server sysfs_devices_system_cpu:dir r_dir_perms;
allow system_server sysfs_devices_system_cpu:file rw_file_perms;
